<?xml version="1.0"?>
<package format="3">
  <name>axiom_marty_demo</name>
  <version>0.1.0</version>
  <description>Read-only Axiom and Marty sensor visualization over ROS 2.</description>
  <maintainer email="hello@robotical.io">Robotical</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>axiom_interfaces</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>axiom_driver</exec_depend>
  <exec_depend>axiom_thermal_viz</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
