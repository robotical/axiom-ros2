{
  "name": "LED Stick",
  "desc": "Addressable RGB LEDs",
  "manu": "Robotical",
  "type": "RoboticalLEDStick",
  "clas": [
    "PIX"
  ],
  "resp": {
    "b": 8,
    "a": [
      {
        "n": "protoVer",
        "at": 0,
        "t": "B",
        "r": [
          0,
          255
        ],
        "f": "d",
        "o": "uint8"
      },
      {
        "n": "flags",
        "at": 1,
        "t": "B",
        "r": [
          0,
          255
        ],
        "f": "02x",
        "o": "uint8",
        "desc": "bit0 show pending, bit1 frame being sent, bit2 pattern running"
      },
      {
        "n": "cmdCount",
        "at": 2,
        "t": "B",
        "r": [
          0,
          255
        ],
        "f": "d",
        "o": "uint8",
        "desc": "commands accepted (wraps at 256)"
      },
      {
        "n": "errCount",
        "at": 3,
        "t": "B",
        "r": [
          0,
          255
        ],
        "f": "d",
        "o": "uint8",
        "desc": "commands rejected (wraps at 256)"
      },
      {
        "n": "lastError",
        "at": 4,
        "t": "B",
        "r": [
          0,
          255
        ],
        "f": "d",
        "o": "uint8",
        "desc": "0 none, 1 bad length, 2 out of range, 3 unknown opcode"
      },
      {
        "n": "lastErrOp",
        "at": 5,
        "t": "B",
        "r": [
          0,
          255
        ],
        "f": "02x",
        "o": "uint8",
        "desc": "opcode of the last rejected command"
      },
      {
        "n": "numPixels",
        "at": 6,
        "t": "B",
        "r": [
          0,
          255
        ],
        "f": "d",
        "o": "uint8"
      },
      {
        "n": "brightness",
        "at": 7,
        "t": "B",
        "r": [
          0,
          255
        ],
        "f": "d",
        "o": "uint8"
      }
    ]
  },
  "actions": [
    {
      "n": "pixels",
      "t": "BBBB",
      "w": "B1",
      "f": "LEDPIX",
      "NX": 8,
      "NY": 4,
      "concat": false,
      "r": [
        0,
        255
      ],
      "desc": "SET_RUN + show, one pixel per write: index R G B"
    },
    {
      "n": "stacklight",
      "t": ">HBBBB",
      "w": "4001",
      "f": "STACKLIGHT",
      "vt": "stacklight",
      "NX": 8,
      "NY": 4,
      "r": [
        0,
        65535
      ],
      "desc": "PATTERN StackLight: basePeriodMs (0 = 250; otherwise 40-65535 ms) then one state byte per tier, bottom tier first; state = mode (bits 0-1: 0 off, 1 steady, 2 flash, 3 flash anti-phase) | rate << 2 (rate 0-3 in bits 2-3; bits 4-7 must be zero; period = base x 2^rate). NY tiers of NX LEDs; tier colours fixed from the top: red, amber, green, blue"
    },
    {
      "n": "colour",
      "t": ">I",
      "w": "B000",
      "f": "06x",
      "r": [
        0,
        16777215
      ],
      "d": 0,
      "desc": "FILL + show over the whole chain: value 0xRRGGBB"
    },
    {
      "n": "brightness",
      "t": "B",
      "w": "B2",
      "f": "d",
      "r": [
        0,
        255
      ],
      "d": 64,
      "desc": "SET_BRIGHTNESS + show (0-255, applied at output)"
    },
    {
      "n": "off",
      "w": "B00000000000",
      "desc": "FILL + show: whole chain black"
    }
  ]
}
