# Send a RICREST URL request (e.g., "traj/getReady") over the active transport.
# Returns the raw JSON text from CMDRESPJSON (with any trailing NUL removed).
string url_path
float32 timeout        # seconds (0 = node default)
string ws_pcol         # optional override: "RICSerial" | "RICFrame" | "RICJSON"
---
bool   success
string json_text
string message