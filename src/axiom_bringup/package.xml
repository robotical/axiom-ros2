<?xml version="1.0"?>
<package format="3">
  <name>axiom_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configs for Axiom.</description>
  <maintainer email="nikos@robotical.io">Nikos</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <exec_depend>axiom_driver</exec_depend>
  <!-- <exec_depend>axiom_interfaces</exec_depend> -->
  <exec_depend>axiom_plotter</exec_depend>


  <!-- only needed when enable_rqt:=true -->
  <exec_depend>rqt_gui</exec_depend>
  <exec_depend>rqt_gui_py</exec_depend>

  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>