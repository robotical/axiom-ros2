# Optional: automatic startup works without this file.
# Use firmware MAC IDs from /axiom_discovery/boards; these are illustrative IDs.
discovery:
  usb: true
  wifi: true
  include_unconfigured: true  # false limits this host to the axioms below.
axioms:
  axiom:
    id: '001122334455'  # Replace with YOUR board's firmware MAC, or remove this entry.
    # No endpoint is needed: USB is preferred when both transports are visible.
    # Optional: transport: serial (USB only), or transport: ws (Wi-Fi only).
    topic_aliases:
      imu/data_raw: {type: LSM6DS, source: imu/data_raw}
      range: {type: VL53L4CD, source: range}
      thermal/image: {type: AMG8833, source: thermal/image}
